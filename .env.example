HYBRID_RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=5
HYBRID_MAX_CANDIDATE_K=500
DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=100
RESULT_PAGE_SIZE_MAX=100
RAG_PROVIDER=extractive
RAG_RETRIEVAL_METHOD=hybrid
RAG_TOP_K=5
RAG_MAX_CLAIMS=5
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_MODEL=
RAG_TIMEOUT_SECONDS=120
ENABLE_EXTERNAL_METADATA_LOOKUP=false
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_READ_CHUNK_BYTES=1048576
INGESTION_POLL_SECONDS=2
INGESTION_LEASE_SECONDS=1200
INGESTION_HEARTBEAT_SECONDS=30
INGESTION_MAX_ATTEMPTS=3
INGESTION_FAILED_RETENTION_DAYS=7
INGESTION_WORKER_ID=
WORKER_ROLE=all
VECTOR_AUTO_REBUILD_ENABLED=true
VECTOR_REBUILD_DEBOUNCE_SECONDS=10

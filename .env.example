APP_ENV=local
DATABASE_URL=postgresql+psycopg://nafion:nafion@localhost:5432/nafion_rag?connect_timeout=5
DATA_ROOT=data
DEFAULT_COLLECTION=literature
GROBID_URL=http://localhost:8070
OCR_LANGUAGES=eng+rus
OCR_ENABLED=true
OCR_COMMAND=ocrmypdf
OCR_TIMEOUT_SECONDS=900
CHUNK_TARGET_CHARS=4500
CHUNK_OVERLAP_CHARS=600
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HYBRID_RRF_K=60
HYBRID_CANDIDATE_MULTIPLIER=5
DEFAULT_TOP_K=10
RAG_PROVIDER=extractive
RAG_RETRIEVAL_METHOD=hybrid
RAG_TOP_K=5
RAG_MAX_CLAIMS=5
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_MODEL=
RAG_TIMEOUT_SECONDS=120
ENABLE_EXTERNAL_METADATA_LOOKUP=false

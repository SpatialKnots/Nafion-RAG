VECTOR_REBUILD_LEASE_SECONDS=1800
VECTOR_REBUILD_HEARTBEAT_SECONDS=30
VECTOR_REBUILD_MAX_ATTEMPTS=3
VECTOR_REBUILD_BATCH_SIZE=64
VECTOR_INDEX_KEEP_GENERATIONS=2
VECTOR_INDEX_CACHE_ENABLED=true
VECTOR_INDEX_CACHE_MAX_ITEMS=2
VECTOR_INDEX_USE_MMAP=false
VECTOR_STAGING_RETENTION_HOURS=24
CONTEXT_MAX_NEIGHBOR_CHUNKS=3
CONTEXT_MAX_CHARS=30000
CONTEXT_MAX_PAGES=5
CONTEXT_HIGHLIGHT_MAX_TERMS=12
TEXT_QUALITY_SHORT_PAGE_CHARS=200
TEXT_QUALITY_CONTROL_CHAR_RATIO=0.02

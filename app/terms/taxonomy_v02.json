    {
      "rule_id": "role_method_adjacent_v01",
      "axis": "role",
      "category": "method",
      "match": "preceding_cue",
      "phrases": [],
      "pattern": "(?i)\\b(?:using|measured\\s+by|characterized\\s+by)\\s+$",
      "require_type": [
        "method"

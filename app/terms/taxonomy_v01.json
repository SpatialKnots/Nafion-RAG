    {"rule_id": "type_process_exact_v01", "axis": "type", "category": "process", "match": "exact_phrase", "phrases": ["casting", "decomposition", "fluorination", "swelling", "annealing", "polymerization", "synthesis", "набухание", "синтез", "разложение", "отжиг"], "pattern": "", "require_type": [], "rationale": "Exact phrase in draft process lexicon; no actor/sample linkage is inferred."},
    {"rule_id": "type_method_exact_v01", "axis": "type", "category": "method", "match": "exact_phrase", "phrases": ["differential scanning calorimetry", "electrochemical impedance spectroscopy", "impedance spectroscopy", "infrared spectroscopy", "nuclear magnetic resonance spectroscopy", "дифференциальная сканирующая калориметрия", "импедансная спектроскопия"], "pattern": "", "require_type": [], "rationale": "Exact full method name; ambiguous abbreviations are not automatically expanded or classified."},
    {"rule_id": "type_condition_exact_v01", "axis": "type", "category": "condition", "match": "exact_phrase", "phrases": ["room temperature", "ambient temperature", "annealing temperature", "mixing temperature", "temperature", "temperatures", "concentration", "комнатная температура", "температура", "концентрация"], "pattern": "", "require_type": [], "rationale": "Draft condition cue lexicon; generic quantity names also have a property candidate and require review."},
    {"rule_id": "role_method_adjacent_v01", "axis": "role", "category": "method", "match": "preceding_cue", "phrases": [], "pattern": "(?i)\\b(?:using|measured\\s+by|characterized\\s+by)\\s+$", "require_type": ["method"], "rationale": "Explicit adjacent method cue plus exact method-name type proposal. Does not prove attachment to a specific sample/result."},
    {"rule_id": "role_comparison_adjacent_v01", "axis": "role", "category": "comparison", "match": "preceding_cue", "phrases": [], "pattern": "(?i)\\b(?:compared\\s+(?:with|to)|versus)\\s+$", "require_type": ["material_substance", "object"], "rationale": "Explicit adjacent comparison cue. No scientific equivalence or comparability is asserted."},
    {"rule_id": "role_study_object_adjacent_v01", "axis": "role", "category": "study_object", "match": "preceding_cue", "phrases": [], "pattern": "(?i)(?:^|[.!?]\\s+)(?:we\\s+(?:investigated|studied)|this\\s+work\\s+investigates)\\s+$", "require_type": ["material_substance", "object"], "rationale": "Explicit sentence-initial author study cue immediately before the selected mention."},
    {"rule_id": "origin_author_adjacent_v01", "axis": "origin", "category": "own_report", "match": "preceding_cue", "phrases": [], "pattern": "(?i)(?:^|[.!?]\\s+)(?:we\\s+(?:measured|observed|found)|our\\s+measurements\\s+of)\\s+$", "require_type": [], "rationale": "Explicit author voice directly before this mention; proposed attribution only, no result validation."},
    {"rule_id": "origin_hypothesis_adjacent_v01", "axis": "origin", "category": "hypothesis", "match": "preceding_cue", "phrases": [], "pattern": "(?i)(?:^|[.!?]\\s+)we\\s+(?:hypothesize|assume)\\s+that\\s+$", "require_type": [], "rationale": "Explicit author hypothesis cue adjacent to the selected mention. Cited-work origin has no automated rule in v0.1."}
  ]

    {"rule_id": "type_object_exact_v01", "axis": "type", "category": "object", "match": "exact_phrase", "phrases": ["membrane", "membranes", "nafion membrane", "nafion membranes", "nafion-117 membrane", "film", "films", "electrode", "electrodes", "anode", "cathode", "cell", "cells", "pouch cells", "battery", "batteries", "lithium-ion batteries", "мембрана", "мембраны", "электрод", "электроды", "анод", "катод", "аккумулятор", "аккумуляторы"], "pattern": "", "require_type": [], "rationale": "Exact phrase in draft object lexicon; composition and study role require separate evidence."},
